{
  "buildCommand": "npm install && npx --yes vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "build": {
    "env": {
      "VITE_API_URL": "https://sonapie-logement.onrender.com/api",
      "VITE_SOCKET_URL": "https://sonapie-logement.onrender.com"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
